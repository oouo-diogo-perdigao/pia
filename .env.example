# ============================================================
# GENERIC
# ============================================================
HOST=0.0.0.0
PORT=8762
OPENAI_COMPAT_API_KEY=local
OPENAI_COMPAT_TIMEOUT_SECONDS=180

# 10MB
OPENAI_COMPAT_MAX_UPLOAD_BYTES=209715200

START_SOUND="../sounds/start.mp3"
END_SOUND="../sounds/end.mp3"
PUBLIC_BASE_URL=127.0.0.1:8762
# HF_TOKEN=

# ============================================================
# STT
# ============================================================
# small, medium, large-v3
STT_MODEL=large-v3-turbo
STT_LANG=pt
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
STT_CPU_THREADS=8
STT_BEAM_SIZE=5
STT_BEST_OF=5
STT_TEMPERATURE=0.0
STT_PROMPT=
STT_SAMPLE_RATE=16000
STT_CHANNELS=1
STT_WHISPER_TIMEOUT=600

# Ordem de tentativa do STT. Os providers são tentados da esquerda para a direita.
# Valores suportados: gemini, groq, local.
STT_PROVIDERS=gemini,groq,local
STT_REMOTE_COOLDOWN_SECONDS=900

# Gemini 3.5 Transcribe Live. Você também pode usar GEMINI_API_KEY; a variável
# STT_GEMINI_API_KEY tem prioridade quando ambas existem.
STT_GEMINI_API_KEY=
STT_GEMINI_MODEL=gemini-3.5-transcribe-live

# Groq Speech-to-Text via LiteLLM. A chave vem de GROQ_API_KEY definida abaixo.
# O prefixo groq/ é usado pelo LiteLLM para selecionar o provider correto.
STT_GROQ_MODEL=groq/whisper-large-v3-turbo

# ============================================================
# TTS
# ============================================================
# Configurações de Áudio e Voz
TTS_DEFAULT_VOICE=pm_santa # Ex: "pm_santa", "pf_dora", "pm_alex", etc
TTS_DEFAULT_SPEED=0.95 # default speed multiplier (0.85 = slow, 1.0 = normal, 1.25 = fast)
TTS_KOKORO_IDLE_TIMEOUT=600 # Tempo de inatividade em segundos (10 min) para liberar VRAM da GPU
TTS_QWEN_IDLE_TIMEOUT=600 # Tempo de inatividade em segundos (5 min) para liberar VRAM da GPU
TTS_DEVICE=cuda # "cuda" para GPU, "cpu" para CPU
TTS_KOKORO_MODEL="./cache/Kokoro-82M"
TTS_LLM_MODEL=free

# ============================================================
# ICE (Image Create/Edit)
# ============================================================
# Gateway Python no Windows, ComfyUI em Docker expondo 8188:
ICE_COMFYUI_URL=http://127.0.0.1:8188
ICE_COMFYUI_TIMEOUT_SECONDS=300
ICE_COMFYUI_POLL_INTERVAL_SECONDS=0.35
ICE_COMFYUI_SERIALIZE_JOBS=true
ICE_COMFYUI_AUTO_FREE=true
ICE_COMFYUI_UNLOAD_MODELS=true
ICE_COMFYUI_FREE_MEMORY=true
ICE_COMFYUI_SAFE_FREE=true
ICE_COMFYUI_MODEL_LAYOUT=checkpoint
# ICE_COMFYUI_MODEL_FAMILY=sdxl
ICE_COMFYUI_CHECKPOINT=sd_xl_base_1.0.safetensors
ICE_COMFYUI_UNET=flux1-schnell.safetensors
ICE_COMFYUI_CLIP_L=clip_l.safetensors
ICE_COMFYUI_T5XXL=t5xxl_fp8_e4m3fn.safetensors
ICE_COMFYUI_VAE=ae.safetensors

ICE_IMAGE_STEPS=4
ICE_IMAGE_CFG=1.0
ICE_IMAGE_SAMPLER=euler
ICE_IMAGE_SCHEDULER=simple
ICE_IMAGE_FLUX_GUIDANCE=3.5
ICE_IMAGE_EDIT_DENOISE=0.65
ICE_IMAGE_EDIT_MASK_DENOISE=1.0
ICE_IMAGE_EDIT_GROW_MASK_BY=6
ICE_IMAGE_VARIATION_DENOISE=0.75
ICE_IMAGE_VARIATION_PROMPT="Create a visually coherent variation of the input image while preserving its main subject and composition."
ICE_IMAGE_DEFAULT_SIZE=1024x1024
ICE_IMAGE_MAX_N=1

# ICE_OUTPUT_CACHE_DIR="cache/ice_images"
ICE_OUTPUT_CACHE_TTL_SECONDS=900

# ============================================================
# AGE Agent / LLM
# ============================================================
AGE_USER_NAME=Mestre
# https://aistudio.google.com/rate-limit?timeRange=last-28-days
AGE_GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
# https://console.groq.com/keys
GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE
# https://dash.cloudflare.com/
CLOUDFLARE_LIMIT=9000 # 10.000 neurons/day free
CLOUDFLARE_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID_HERE
CLOUDFLARE_API_TOKEN=YOUR_CLOUDFLARE_API_TOKEN_HERE
# https://openrouter.ai/workspaces/default/keys/
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY_HERE

# Política padrão para chamadas internas e /v1/chat/completions sem model.
# Hierarquia: all >= paid >= free >= local. Exemplos: all-local, free-local+gemini=paid.
LLM_MODEL=free
# Ordem de tentativa dos providers. Acrescente openrouter,cloudflare se configurados.
LLM_PROVIDERS=gemini,groq,local
LLM_REMOTE_COOLDOWN_SECONDS=300
# Lista ordenada de modelos Gemini classificados como free; disponibilidade depende da conta.
LLM_GEMINI_FREE_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3-flash-preview,gemini-2.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash-lite
LLM_GEMINI_PAID_MODELS=
LLM_GROQ_MODEL=groq/openai/gpt-oss-120b
LLM_LOCAL_MODEL=ollama/qwen3:8b
# Opcional: vários modelos locais, em ordem; substitui LLM_LOCAL_MODEL.
# LLM_LOCAL_MODELS=ollama/qwen3:8b,ollama/llama3.2:3b
LLM_LOCAL_API_BASE=http://localhost:11434

# ============================================================
# OVE
# ============================================================
OVE_RATE = 16000
OVE_CHANNELS = 1
OVE_CHUNK = 1280
OVE_THRESHOLD = 0.5

# Outros providers: nomes LiteLLM, sem o prefixo do provider (também aceito).
# A classificação free/paid é configuração, não uma garantia de cobrança.
LLM_GROQ_PAID_MODELS=
LLM_OPENROUTER_FREE_MODELS=
LLM_OPENROUTER_PAID_MODELS=
OPENROUTER_API_KEY=
LLM_CLOUDFLARE_FREE_MODELS=
LLM_CLOUDFLARE_PAID_MODELS=
CLOUDFLARE_API_KEY=
# Configure a URL compatível com sua conta/integração Cloudflare.
LLM_CLOUDFLARE_API_BASE=
# Catálogo adicional JSON, sem credenciais; informe somente nomes de variáveis.
# Exemplo: [{"provider":"custom","model":"openai/my-model","tier":"paid","api_key_env":"CUSTOM_API_KEY","api_base_env":"CUSTOM_API_BASE"}]
LLM_MODEL_CATALOG=[]
# Limite preventivo de upload de áudio ao Groq.
STT_GROQ_MAX_UPLOAD_BYTES=25000000
