# Configurações específicas do podcast; integrações ficam nos plugins compartilhados.
TZ=America/Sao_Paulo
PODCAST_CONFIG=config/config.json
POLL_INTERVAL_SECONDS__INT=600
DRIVE_PROCESS__BOOL=true
LOCAL_DRIVE_FOLDER__PATH=data/local-drive
DOWNLOAD_DIR__PATH=data/download
WORK_DIR__PATH=data/work
PUBLICAR_DIRETO__BOOL=false


OWNER_EMAIL=

TRANSCRIPTS_FILE=transcripts.html
SKIP_CLOSED__BOOL=true
FEED_CACHE_DIR__PATH=data/cache/feeds
FEED_FORCE_REBUILD__BOOL=false
