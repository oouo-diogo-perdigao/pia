# Configurações do Servidor
HOST=0.0.0.0
PORT=8764
OPENAI_COMPAT_API_KEY=local

# Gateway Python no Windows, ComfyUI em Docker expondo 8188:
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_TIMEOUT_SECONDS=300
COMFYUI_POLL_INTERVAL_SECONDS=0.35
COMFYUI_AUTO_FREE=true
COMFYUI_UNLOAD_MODELS=true
COMFYUI_FREE_MEMORY=true
COMFYUI_SAFE_FREE=true
COMFYUI_SERIALIZE_JOBS=true

COMFYUI_MODEL_LAYOUT=checkpoint
# COMFYUI_MODEL_FAMILY=sdxl
COMFYUI_CHECKPOINT=sd_xl_base_1.0.safetensors

IMAGE_STEPS=25
IMAGE_CFG=6.0
IMAGE_SAMPLER=dpmpp_2m_sde
IMAGE_SCHEDULER=karras

IMAGE_EDIT_DENOISE=0.55
IMAGE_EDIT_MASK_DENOISE=1.0
IMAGE_EDIT_GROW_MASK_BY=6
IMAGE_VARIATION_DENOISE=0.65

OPENAI_IMAGE_MODEL_ID=gpt-image-1
IMAGE_DEFAULT_SIZE=1024x1024
IMAGE_MAX_N=1
# IMAGE_FLUX_GUIDANCE=3.5

IMAGE_VARIATION_PROMPT=Create a visually coherent variation of the input image while preserving its main subject and composition.

PUBLIC_BASE_URL=
IMAGE_OUTPUT_CACHE_TTL_SECONDS=900
