{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "STT Service",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "--directory",
        "${workspaceFolder}/speech_to_text",
        "python",
        "-m",
        "watchfiles",
        "python -m server"
      ],
      "console": "integratedTerminal"
    },
    {
      "name": "TTS Service",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "--directory",
        "${workspaceFolder}/text_to_speech",
        "python",
        "-m",
        "watchfiles",
        "python -m server"
      ],
      "console": "integratedTerminal"
    },
    {
      "name": "Agent Service",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "--directory",
        "${workspaceFolder}/agent",
        "python",
        "-m",
        "watchfiles",
        "python -m server"
      ],
      "console": "integratedTerminal"
    },
    {
      "name": "Pia Principal",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "--directory",
        "${workspaceFolder}/pia",
