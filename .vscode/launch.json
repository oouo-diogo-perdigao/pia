        "-m",
        "watchfiles",
        "python -m server"
      ],
      "console": "integratedTerminal"
    }
  ],
  "compounds": [
    {
      "name": "Iniciar Todos os Serviços (F5)",
      "configurations": [
        "STT Service",
        "TTS Service",
        "Agent Service",
        "Pia Principal"
      ]
    }
  ]
}