# ============================================================
# STT
# ============================================================
# small, medium, large-v3
HOST=127.0.0.1
PORT=8762
STT_MODEL=large-v3-turbo
STT_LANG=pt
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
STT_CPU_THREADS=8
STT_BEAM_SIZE=5
STT_BEST_OF=5
STT_TEMPERATURE=0.0
STT_PROMPT=
SAMPLE_RATE=16000
CHANNELS=1

OPENAI_COMPAT_API_KEY=local
OPENAI_COMPAT_TIMEOUT_SECONDS=180
OPENAI_COMPAT_MAX_UPLOAD_BYTES=104857600

# Configurações de Áudio e Voz
DEFAULT_VOICE=pm_santa # Ex: "pm_santa", "pf_dora", "pm_alex", etc
DEFAULT_SPEED=0.95 # default speed multiplier (0.85 = slow, 1.0 = normal, 1.25 = fast)
# SAMPLE_RATE=24000

IDLE_TIMEOUT_KOKORO=600 # Tempo de inatividade em segundos (10 min) para liberar VRAM da GPU
IDLE_TIMEOUT_QWEN=300 # Tempo de inatividade em segundos (5 min) para liberar VRAM da GPU
DEVICE=cuda # "cuda" para GPU, "cpu" para CPU
